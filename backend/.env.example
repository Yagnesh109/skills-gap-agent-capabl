JOOBLE_API_KEY=your_key_here

# Single Common Gemini Key (used by default across all agents)
GEMINI_API_KEY=your_gemini_api_key_here

# OR Dedicated API Keys for separate rate limits & quota limits:
# Key 1: Profile Parsing Agent (Step 1)
GEMINI_API_KEY_PROFILE_PARSING=your_first_gemini_api_key_here

# Key 2: Gap Analysis Agent (Step 3)
GEMINI_API_KEY_GAP_ANALYSIS=your_second_gemini_api_key_here

GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=20

